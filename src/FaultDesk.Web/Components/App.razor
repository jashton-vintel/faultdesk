<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#ea0474" />
    <base href="/" />
    <ResourcePreloader />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="@Assets["lib/bootstrap/dist/css/bootstrap.min.css"]" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["FaultDesk.Web.styles.css"]" />
    <ImportMap />
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Ccircle cx='16' cy='16' r='9' fill='%23ea0474'/%3E%3Ccircle cx='16' cy='16' r='14' fill='none' stroke='%23f7e0ec' stroke-width='3'/%3E%3C/svg%3E" />
    <HeadOutlet @rendermode="RenderModes.Server" />
</head>

<body>
    @* Interactive server everywhere, without prerendering: components initialise once and AI work only ever starts from a user action. *@
    <Routes @rendermode="RenderModes.Server" />
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>

@code {
    private static class RenderModes
    {
        public static readonly InteractiveServerRenderMode Server = new(prerender: false);
    }
}
