@page "/customer/submitted/{Id:guid}"
@inject GetTicketDetailHandler GetTicketDetail

<PageTitle>Report received - FaultDesk</PageTitle>

@if (_loading)
{
    <div class="d-flex align-items-center gap-2 text-secondary"><span class="spinner-border spinner-border-sm text-pink"></span> Loading your report...</div>
}
else if (_ticket is null)
{
    <div class="alert alert-warning">We couldn't find that report. <a href="customer/report">Start again</a>.</div>
}
else
{
    <div class="card tint-pink mb-3">
        <div class="card-body py-4">
            <div class="section-label pink mb-1">Report received</div>
            <h1 class="h3">Thanks, we've got it.</h1>
            <p class="mb-0">
                Your reference is <span class="pill pill-dark no-dot font-monospace">@_ticket.Reference</span>.
                A service adviser will review your report and get in touch to book the car in.
            </p>
        </div>
    </div>

    <div class="row g-3">
        @if (_ticket.Triage is { } triage)
        {
            <div class="col-md-6">
                <div class="card h-100">
                    <div class="card-body">
                        <div class="section-label mb-2">What we understood</div>
                        @if (!string.IsNullOrWhiteSpace(triage.CustomerSummary))
                        {
                            <p>@triage.CustomerSummary</p>
                        }
                        <span class="pill @Display.SafeToDrivePill(triage.SafeToDrive) mb-2">@Display.SafeToDrive(triage.SafeToDrive)</span>
                        <p class="small text-secondary mb-0">
                            @(triage.SafeToDrive switch
                            {
                                SafeToDrive.No => "Please don't drive the car until it has been checked; we'll call you to arrange recovery or a priority booking.",
                                SafeToDrive.Caution => "Keep journeys short and gentle until we've looked at it. If it gets worse, stop driving and call us.",
                                SafeToDrive.Yes => "Nothing in your description suggests it's unsafe to drive, but do get it looked at soon.",
                                _ => "We'll assess how urgent this is when we review your report.",
                            })
                        </p>
                    </div>
                </div>
            </div>
        }

        <div class="@(_ticket.Triage is null ? "col-12" : "col-md-6")">
            <div class="card h-100">
                <div class="card-body">
                    <div class="section-label mb-2">What you told us</div>
                    <div class="mb-2">
                        <span class="reg-plate sm">@_ticket.Registration.Display</span>
                        <span class="ms-1 small text-secondary">@_ticket.Vehicle.Summary</span>
                    </div>
                    <p class="pre-line mb-2">@_ticket.Description</p>
                    <div class="small text-secondary">Received @Display.LocalTime(_ticket.CreatedAt)</div>
                </div>
            </div>
        </div>
    </div>

    <a class="btn btn-outline-primary mt-3" href="customer/report">Report another problem</a>
}

@code {
    [Parameter]
    public Guid Id { get; set; }

    private bool _loading = true;
    private FaultTicket? _ticket;

    protected override async Task OnInitializedAsync()
    {
        var detail = await GetTicketDetail.HandleAsync(new TicketId(Id), CancellationToken.None);
        _ticket = detail?.Ticket;
        _loading = false;
    }
}
