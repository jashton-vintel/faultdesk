@page "/garage"
@inject ListTicketsHandler ListTickets

<PageTitle>Tickets - FaultDesk</PageTitle>

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h1 class="h3 mb-0">Tickets</h1>
    <div class="d-flex gap-2 align-items-center">
        <select class="form-select form-select-sm w-auto" @bind="_statusFilter" aria-label="Filter by status">
            <option value="">All statuses</option>
            @foreach (var status in Enum.GetValues<TicketStatus>())
            {
                <option value="@status">@Display.Status(status)</option>
            }
        </select>
        <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="LoadAsync" disabled="@_loading">Refresh</button>
    </div>
</div>

@if (_error is not null)
{
    <div class="alert alert-danger">@_error</div>
}

@if (_loading)
{
    <div class="d-flex align-items-center gap-2 text-secondary"><span class="spinner-border spinner-border-sm"></span> Loading tickets...</div>
}
else if (_tickets.Count == 0)
{
    <div class="alert alert-light border">No tickets yet. Submit one from the <a href="customer/report">customer portal</a>.</div>
}
else
{
    <div class="table-responsive">
        <QuickGrid Items="Filtered" Class="table table-hover align-middle" Pagination="_pagination">
            <TemplateColumn Title="Received" Sortable="true" SortBy="GridSort<TicketSummary>.ByDescending(t => t.CreatedAt)"
                            IsDefaultSortColumn="true" InitialSortDirection="SortDirection.Ascending">
                <span class="text-nowrap">@context.CreatedAt.ToLocalTime().ToString("d MMM HH:mm")</span>
            </TemplateColumn>
            <PropertyColumn Property="t => t.Registration" Title="Reg" Sortable="true" Class="font-monospace text-nowrap" />
            <PropertyColumn Property="t => t.Vehicle" Title="Vehicle" Sortable="true" />
            <TemplateColumn Title="Fault" Sortable="true" SortBy="GridSort<TicketSummary>.ByAscending(t => t.Headline)">
                <a href="garage/tickets/@context.Id.Value" class="fw-semibold">@context.Headline</a>
                <div class="small text-secondary">@Display.Category(context.Category) &middot; <span class="font-monospace">@context.Reference</span></div>
            </TemplateColumn>
            <TemplateColumn Title="Severity" Sortable="true" SortBy="GridSort<TicketSummary>.ByDescending(t => t.Severity)">
                <SeverityBadge Severity="context.Severity" />
            </TemplateColumn>
            <TemplateColumn Title="Status" Sortable="true" SortBy="GridSort<TicketSummary>.ByAscending(t => t.Status)">
                <StatusBadge Status="context.Status" />
            </TemplateColumn>
        </QuickGrid>
    </div>
    <Paginator State="_pagination" />
}

@code {
    private readonly PaginationState _pagination = new() { ItemsPerPage = 15 };
    private IReadOnlyList<TicketSummary> _tickets = [];
    private string _statusFilter = string.Empty;
    private bool _loading = true;
    private string? _error;

    private IQueryable<TicketSummary> Filtered =>
        (Enum.TryParse<TicketStatus>(_statusFilter, out var status)
            ? _tickets.Where(t => t.Status == status)
            : _tickets)
        .AsQueryable();

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            _tickets = await ListTickets.HandleAsync(CancellationToken.None);
        }
        catch (Exception ex)
        {
            _error = $"Could not load tickets: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }
}
