@* The AI's structured reading of the customer's words. Extracted, not diagnosed. *@

<div class="card mb-3">
    <div class="card-body">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
            <div class="section-label pink">AI triage</div>
            <span class="small text-secondary">extracted from the description, not verified</span>
        </div>

        <div class="row g-3">
            <div class="col-md-6">
                @if (Triage.Symptoms.Length > 0)
                {
                    <div class="section-label mb-1">Symptoms</div>
                    <div class="d-flex flex-wrap gap-1 mb-3">
                        @foreach (var symptom in Triage.Symptoms)
                        {
                            <span class="symptom">@symptom</span>
                        }
                    </div>
                }

                @if (Triage.LikelySystems.Length > 0)
                {
                    <div class="section-label mb-1">Systems mentioned</div>
                    <div>@string.Join(", ", Triage.LikelySystems)</div>
                }
            </div>
            <div class="col-md-6">
                @if (Triage.AdviserQuestions.Length > 0)
                {
                    <div class="section-label mb-1">Ask the customer</div>
                    <ul class="mb-0 ps-3">
                        @foreach (var question in Triage.AdviserQuestions)
                        {
                            <li class="mb-1">@question</li>
                        }
                    </ul>
                }
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(Triage.CustomerSummary))
        {
            <div class="small text-secondary border-top pt-2 mt-3">Told the customer: "@Triage.CustomerSummary"</div>
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public TriageSummary Triage { get; set; } = null!;
}
