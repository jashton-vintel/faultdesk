@* The AI's structured reading of the customer's words, for the service adviser. Extracted, not diagnosed. *@

<div class="card shadow-sm mb-3">
    <div class="card-body">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
            <h2 class="h5 mb-0">AI triage</h2>
            <div class="d-flex gap-1">
                <span class="badge bg-secondary">@Display.Category(Triage.Category)</span>
                <SeverityBadge Severity="Triage.Severity" />
                <span class="badge bg-@Display.SafeToDriveColour(Triage.SafeToDrive)">@Display.SafeToDrive(Triage.SafeToDrive)</span>
            </div>
        </div>

        @if (Triage.Symptoms.Length > 0)
        {
            <div class="mb-2">
                <span class="small text-secondary text-uppercase">Symptoms</span>
                <div class="d-flex flex-wrap gap-1 mt-1">
                    @foreach (var symptom in Triage.Symptoms)
                    {
                        <span class="badge rounded-pill text-bg-light border">@symptom</span>
                    }
                </div>
            </div>
        }

        @if (Triage.LikelySystems.Length > 0)
        {
            <div class="mb-2">
                <span class="small text-secondary text-uppercase">Systems mentioned</span>
                <div>@string.Join(", ", Triage.LikelySystems)</div>
            </div>
        }

        @if (Triage.AdviserQuestions.Length > 0)
        {
            <div class="mb-2">
                <span class="small text-secondary text-uppercase">Ask the customer</span>
                <ul class="mb-0 mt-1">
                    @foreach (var question in Triage.AdviserQuestions)
                    {
                        <li>@question</li>
                    }
                </ul>
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(Triage.CustomerSummary))
        {
            <div class="small text-secondary border-top pt-2 mt-2">Customer-facing summary: "@Triage.CustomerSummary"</div>
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public TriageSummary Triage { get; set; } = null!;
}
