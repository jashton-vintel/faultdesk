@page "/garage/tickets/{Id:guid}"
@inject GetTicketDetailHandler GetTicketDetail

<PageTitle>@(_detail is null ? "Ticket" : _detail.Ticket.Reference) - FaultDesk</PageTitle>

@if (_loading)
{
    <div class="d-flex align-items-center gap-2 text-secondary"><span class="spinner-border spinner-border-sm text-pink"></span> Loading ticket...</div>
}
else if (_error is not null)
{
    <div class="alert alert-danger">@_error</div>
}
else if (_detail is null)
{
    <div class="alert alert-warning">Ticket not found. <a href="garage">Back to tickets</a>.</div>
}
else
{
    var ticket = _detail.Ticket;

    <div class="d-flex align-items-center gap-2 small mb-2">
        <a href="garage" class="text-secondary">Tickets</a>
        <span class="text-secondary">/</span>
        <span class="font-monospace">@ticket.Reference</span>
    </div>

    @* Everything an adviser needs at a glance: what, which car, how urgent, and what to do next. *@
    <div class="ticket-header mb-3">
            <div class="d-flex align-items-start gap-3">
                <span class="reg-plate fs-5 mt-1">@ticket.Registration.Display</span>
                <div>
                    <div class="d-flex flex-wrap align-items-center gap-2">
                        <h1 class="h4 mb-0">@ticket.Headline</h1>
                        <StatusBadge Status="ticket.Status" />
                    </div>
                    <div class="text-secondary small mt-1">
                        @ticket.Vehicle.Summary
                        &middot; received @Display.LocalTime(ticket.CreatedAt)
                        @if (ticket.CustomerName is not null)
                        {
                            <text> &middot; @ticket.CustomerName</text>
                        }
                        @if (ticket.CustomerContact is not null)
                        {
                            <text> (@ticket.CustomerContact)</text>
                        }
                    </div>
                    @if (ticket.Triage is { } triage)
                    {
                        <div class="d-flex flex-wrap gap-1 mt-2">
                            <span class="pill pill-grey no-dot">@Display.Category(triage.Category)</span>
                            <SeverityBadge Severity="triage.Severity" />
                            <span class="pill @Display.SafeToDrivePill(triage.SafeToDrive)">@Display.SafeToDrive(triage.SafeToDrive)</span>
                        </div>
                    }
                </div>
            </div>
            <StatusActions Ticket="ticket" OnChanged="LoadAsync" />
    </div>

    <div class="ticket-grid">
        <div class="area-a">
            @if (ticket.Resolution is { } resolution)
            {
                <div class="card tint-green mb-3">
                    <div class="card-body">
                        <div class="section-label mb-1" style="color: #0a7a52;">Resolution &middot; @Display.LocalTime(resolution.ResolvedAt)</div>
                        <p class="mb-0 pre-line">@resolution.Notes</p>
                    </div>
                </div>
            }

            <div class="card mb-3">
                <div class="card-body">
                    <div class="section-label mb-2">Customer's description</div>
                    <p class="mb-0 pre-line">@ticket.Description</p>
                </div>
            </div>

            @if (ticket.Triage is { } triageDetail)
            {
                <TriageCard Triage="triageDetail" />
            }
        </div>

        <div class="area-b">
            <div class="ticket-rail">
                <RelatedTickets History="_detail.VehicleHistory" Similar="_detail.SimilarTickets" />
            </div>
        </div>

        <div class="area-c">
            <InvestigationPanel TicketId="ticket.Id" Investigations="_detail.Investigations" />
        </div>
    </div>
}

@code {
    [Parameter]
    public Guid Id { get; set; }

    private TicketDetail? _detail;
    private bool _loading = true;
    private string? _error;

    protected override Task OnParametersSetAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _loading = _detail is null;
        _error = null;
        try
        {
            _detail = await GetTicketDetail.HandleAsync(new TicketId(Id), CancellationToken.None);
        }
        catch (Exception ex)
        {
            _error = $"Could not load the ticket: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }
}
