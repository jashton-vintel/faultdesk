@using System.Diagnostics
@using System.Text
@using FaultDesk.Domain.Diagnostics
@using FaultDesk.Web.Services
@implements IDisposable
@inject InvestigateTicketHandler Investigate
@inject MarkdownRenderer Markdown
@inject ILogger<InvestigationPanel> Logger

<div class="card shadow-sm mb-3">
    <div class="card-body">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
            <h2 class="h5 mb-0">AI Investigate</h2>
            <button type="button" class="btn btn-primary btn-sm" @onclick="RunAsync" disabled="@_running">
                @(_running ? "Investigating..." : Latest is null ? "AI Investigate" : "Run again")
            </button>
        </div>
        <p class="small text-secondary">
            Builds a prompt from the vehicle, the customer's words, the triage and the related tickets, asks the model to
            search the web for matching faults on this car, and streams back a plan for the workshop. It is a starting
            point for a technician, not a diagnosis.
        </p>

        @if (_error is not null)
        {
            <div class="alert alert-danger py-2">@_error</div>
        }

        @if (_running)
        {
            <div class="small text-secondary mb-2">
                <span class="spinner-border spinner-border-sm me-1"></span>
                Working&hellip; @(_stopwatch?.Elapsed.TotalSeconds.ToString("F0"))s
            </div>
            <div class="report-markdown">@Markdown.ToHtml(_streamed.ToString())</div>
        }
        else if (Latest is { } latest)
        {
            <div class="report-markdown">@Markdown.ToHtml(latest.ReportMarkdown)</div>
            <div class="small text-secondary border-top pt-2 mt-3">@Provenance(latest)</div>
        }
        else
        {
            <p class="text-secondary small mb-0">No investigation yet.</p>
        }

        @if (_history.Count > 1)
        {
            <details class="mt-3">
                <summary class="small text-secondary">Previous runs (@(_history.Count - 1))</summary>
                <ul class="small mb-0 mt-2">
                    @foreach (var run in _history.Skip(1))
                    {
                        <li>@Provenance(run)</li>
                    }
                </ul>
            </details>
        }
    </div>
</div>

@code {
    private static readonly TimeSpan Timeout = TimeSpan.FromMinutes(4);

    [Parameter, EditorRequired]
    public TicketId TicketId { get; set; }

    /// <summary>Previously persisted investigations, newest first.</summary>
    [Parameter]
    public IReadOnlyList<Investigation> Investigations { get; set; } = [];

    private readonly StringBuilder _streamed = new();
    private List<Investigation> _history = [];
    private bool _running;
    private bool _disposed;
    private string? _error;
    private CancellationTokenSource? _cts;
    private Stopwatch? _stopwatch;

    private Investigation? Latest => _history.Count > 0 ? _history[0] : null;

    /// <summary>Who produced this report and what it cost: provider/model, prompt version, tokens, wall time, web search.</summary>
    private static string Provenance(Investigation run)
    {
        var m = run.Metadata;
        var tokens = m.InputTokens is null && m.OutputTokens is null
            ? "token usage not reported"
            : $"{m.InputTokens?.ToString("N0") ?? "?"} in / {m.OutputTokens?.ToString("N0") ?? "?"} out tokens";

        return $"{Display.LocalTime(run.CreatedAt)} · {m.Provider} {m.Model} · prompt {m.PromptVersion} · {tokens} · {m.Duration.TotalSeconds:F1}s · {(m.WebSearchUsed ? "with" : "without")} web search";
    }

    protected override void OnParametersSet()
    {
        if (!_running)
        {
            _history = Investigations.ToList();
        }
    }

    private async Task RunAsync()
    {
        if (_running)
        {
            return;
        }

        _running = true;
        _error = null;
        _streamed.Clear();
        _cts = new CancellationTokenSource(Timeout);
        _stopwatch = Stopwatch.StartNew();
        var lastRender = Stopwatch.StartNew();

        try
        {
            await foreach (var update in Investigate.HandleAsync(TicketId, _cts.Token))
            {
                if (update.TextDelta is { } text)
                {
                    _streamed.Append(text);
                }

                if (update.Completed is { } completed)
                {
                    _history.Insert(0, completed);
                }

                // Re-render at most ~10 times a second; each render diffs the whole markdown block.
                if (lastRender.ElapsedMilliseconds > 100 || update.Completed is not null)
                {
                    StateHasChanged();
                    lastRender.Restart();
                }
            }
        }
        catch (OperationCanceledException)
        {
            if (!_disposed)
            {
                _error = $"The investigation was stopped after {Timeout.TotalMinutes:F0} minutes without completing.";
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "AI investigation failed for ticket {TicketId}", TicketId);
            _error = $"The investigation failed: {ex.Message}";
        }
        finally
        {
            _running = false;
            _stopwatch?.Stop();
            _cts?.Dispose();
            _cts = null;
            if (!_disposed)
            {
                StateHasChanged();
            }
        }
    }

    public void Dispose()
    {
        _disposed = true;
        _cts?.Cancel();
    }
}
