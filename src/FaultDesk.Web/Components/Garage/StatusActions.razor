@inject TicketWorkflowHandler Workflow
@inject ILogger<StatusActions> Logger

@* Renders two siblings so the ticket header grid can place the buttons top-right and the resolve form full-width below. *@
<div class="ticket-actions d-flex flex-wrap gap-2 align-items-start justify-content-lg-end">
        @switch (Ticket.Status)
        {
            case TicketStatus.New:
                <button type="button" class="btn btn-outline-primary btn-sm" @onclick="StartAsync" disabled="@_busy">Start work</button>
                <button type="button" class="btn btn-primary btn-sm" @onclick="() => _resolving = !_resolving" disabled="@_busy">Resolve</button>
                break;
            case TicketStatus.InProgress:
                <button type="button" class="btn btn-primary btn-sm" @onclick="() => _resolving = !_resolving" disabled="@_busy">Resolve</button>
                break;
            case TicketStatus.Resolved:
                <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="ReopenAsync" disabled="@_busy">Reopen</button>
                break;
        }
</div>

@if (_error is not null || _resolving)
{
    <div class="ticket-resolve">
    @if (_error is not null)
    {
        <div class="alert alert-danger py-2 mb-2 small">@_error</div>
    }

    @if (_resolving)
    {
        <div class="card tint-green">
            <div class="card-body py-3">
                <label class="form-label small" for="resolution-notes">What did the workshop find and do?</label>
                <textarea id="resolution-notes" class="form-control form-control-sm mb-2" rows="3" @bind="_notes" disabled="@_busy"
                          placeholder="e.g. Front discs lipped and pads worn to the metal. Replaced discs and pads, bled brakes, road tested."></textarea>
                <div class="form-text mb-2">Embedded with the ticket, so the next similar fault surfaces this fix.</div>
                <button type="button" class="btn btn-success btn-sm" @onclick="ResolveAsync" disabled="@_busy">@(_busy ? "Saving..." : "Save resolution")</button>
                <button type="button" class="btn btn-link btn-sm" @onclick="() => _resolving = false" disabled="@_busy">Cancel</button>
            </div>
        </div>
    }
    </div>
}

@code {
    [Parameter, EditorRequired]
    public FaultTicket Ticket { get; set; } = null!;

    /// <summary>Raised after a successful change so the page can reload the ticket and its related data.</summary>
    [Parameter]
    public EventCallback OnChanged { get; set; }

    private bool _busy;
    private bool _resolving;
    private string _notes = string.Empty;
    private string? _error;

    private Task StartAsync() => ChangeAsync(ct => Workflow.StartAsync(Ticket.Id, ct));

    private Task ReopenAsync() => ChangeAsync(ct => Workflow.ReopenAsync(Ticket.Id, ct));

    private Task ResolveAsync() => ChangeAsync(async ct =>
    {
        await Workflow.ResolveAsync(Ticket.Id, _notes, ct);
        _resolving = false;
        _notes = string.Empty;
    });

    private async Task ChangeAsync(Func<CancellationToken, Task> change)
    {
        _error = null;
        _busy = true;
        try
        {
            await change(CancellationToken.None);
            await OnChanged.InvokeAsync();
        }
        catch (DomainException ex)
        {
            _error = ex.Message;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Workflow change failed for ticket {TicketId}", Ticket.Id);
            _error = $"Could not update the ticket: {ex.Message}";
        }
        finally
        {
            _busy = false;
        }
    }
}
