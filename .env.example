# Copy to .env (git-ignored) and edit. Never commit .env.

# SQL Server 2025 container. Must be 8+ characters with upper, lower, digit and symbol.
# The same password is used by the app container's connection string (and by appsettings.Development.json for `dotnet run`).
MSSQL_SA_PASSWORD=FaultDesk_Dev_Passw0rd!

# AI providers. Mock needs no keys and is the default: triage, follow-up questions and AI Investigate return canned
# answers and similarity search uses hashed bag-of-words vectors.
#   AI_CHAT_PROVIDER:      Mock | Anthropic | OpenAI
#   AI_EMBEDDING_PROVIDER: Mock | OpenAI       (Anthropic has no embeddings API)
AI_CHAT_PROVIDER=Mock
AI_EMBEDDING_PROVIDER=Mock

# Keys are only read when the matching provider is selected.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
